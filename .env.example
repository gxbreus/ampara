# Copie para .env e preencha. O .env nunca vai para o repositório (.gitignore).
#   cp .env.example .env
#   ./scripts/gerar-chaves-jwt.sh      # preenche JWT_PRIVATE_KEY e JWT_PUBLIC_KEY

# --- Identidade (postgres-identidade) ---
IDENTIDADE_DB_USER=
IDENTIDADE_DB_PASSWORD=
# postgresql://USUARIO:SENHA@postgres-identidade:5432/identidade
IDENTIDADE_DATABASE_URL=

# --- Animais (mongo-animais, replica set rs0) ---
ANIMAIS_DB_USER=
ANIMAIS_DB_PASSWORD=
# replicaSet=rs0 e authSource=admin são obrigatórios: sem eles a transação do outbox falha
# mongodb://USUARIO:SENHA@mongo-animais:27017/animais?replicaSet=rs0&authSource=admin
ANIMAIS_MONGO_URL=
# mesmo host, database animais_leitura (projeção do CQRS)
ANIMAIS_LEITURA_MONGO_URL=

# --- Adoção (postgres-adocao) ---
ADOCAO_DB_USER=
ADOCAO_DB_PASSWORD=
# postgresql://USUARIO:SENHA@postgres-adocao:5432/adocao
ADOCAO_DATABASE_URL=
ADOCAO_TIMEOUT_PASSO=10s
# 72h em produção; 2m na demo
ADOCAO_PRAZO_EXPIRACAO=72h
ADOCAO_MAX_REENVIOS_COMPENSACAO=10

# --- Notificações (redis-notificacoes) ---
NOTIFICACOES_REDIS_PASSWORD=
# redis://:SENHA@redis-notificacoes:6379/0
NOTIFICACOES_REDIS_URL=

# --- Assistente (qdrant-assistente e redis-assistente) ---
QDRANT_URL=http://qdrant-assistente:6333
ASSISTENTE_REDIS_PASSWORD=
# redis://:SENHA@redis-assistente:6379/0
ASSISTENTE_REDIS_URL=
LLM_PROVIDER=groq
LLM_MODEL=
LLM_API_KEY=
LLM_FALLBACK_MODEL=
EMBEDDINGS_PROVIDER=ollama
EMBEDDINGS_MODEL=bge-m3

# --- RabbitMQ: um usuário por serviço (docs/contratos/eventos.md, seção 7) ---
# admin só para o painel e para o scripts/dlq.sh; nenhum serviço usa este usuário
RABBITMQ_ADMIN_USER=
RABBITMQ_ADMIN_PASSWORD=
RABBITMQ_ADOCAO_PASSWORD=
RABBITMQ_ANIMAIS_PASSWORD=
RABBITMQ_IDENTIDADE_PASSWORD=
RABBITMQ_NOTIFICACOES_PASSWORD=
# amqp://USUARIO:SENHA@rabbitmq:5672/  (o usuário é o nome do serviço: adocao, animais, ...)
ADOCAO_AMQP_URL=
ANIMAIS_AMQP_URL=
IDENTIDADE_AMQP_URL=
NOTIFICACOES_AMQP_URL=

# --- JWT RS256 (gerado por scripts/gerar-chaves-jwt.sh) ---
# Uma linha só, entre aspas duplas, com as quebras escapadas como \n: o Compose converte
# o \n em quebra de linha ao entregar a variável ao contêiner, então o serviço recebe o PEM.
# A Identidade assina com a privada; gateway, BFFs e serviços validam com a pública.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
