{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AnimalReservado v1 (payload)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "animalId",
    "responsavelId",
    "animalNome"
  ],
  "properties": {
    "animalId": {
      "type": "string",
      "pattern": "^[0-9a-f]{24}$",
      "description": "ObjectId do animal no MongoDB"
    },
    "responsavelId": {
      "type": "string",
      "format": "uuid"
    },
    "animalNome": {
      "type": "string"
    }
  }
}
