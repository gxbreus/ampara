# usado pelo redis-assistente (--requirepass)
REDIS_PASSWORD=${ASSISTENTE_REDIS_PASSWORD}
# usado pelo serviço
ASSISTENTE_REDIS_URL=redis://:${ASSISTENTE_REDIS_PASSWORD}@redis-assistente:6379/0
# opcional: vazia, o Assistente sobe em modo degradado, com fallback (#69)
LLM_API_KEY=${LLM_API_KEY:-}
# opcionais: reservas gratuitas de outros provedores
GROQ_API_KEY=${GROQ_API_KEY:-}
OPENROUTER_API_KEY=${OPENROUTER_API_KEY:-}
