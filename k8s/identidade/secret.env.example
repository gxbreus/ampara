# PostgreSQL
POSTGRES_USER=${IDENTIDADE_DB_USER}
POSTGRES_PASSWORD=${IDENTIDADE_DB_PASSWORD}
# Serviço
IDENTIDADE_DATABASE_URL=postgresql://${IDENTIDADE_DB_USER}:${IDENTIDADE_DB_PASSWORD}@postgres-identidade:5432/identidade
