# usado pelo postgres-orquestrador
POSTGRES_USER=${ORQUESTRADOR_DB_USER}
POSTGRES_PASSWORD=${ORQUESTRADOR_DB_PASSWORD}
# usado pelo serviço: a URL do banco e a do RabbitMQ, com o usuário "orquestrador"
ORQUESTRADOR_DATABASE_URL=postgres://${ORQUESTRADOR_DB_USER}:${ORQUESTRADOR_DB_PASSWORD}@postgres-orquestrador:5432/orquestrador?sslmode=disable
ORQUESTRADOR_AMQP_URL=amqp://orquestrador:${RABBITMQ_ORQUESTRADOR_PASSWORD}@rabbitmq:5672/
