{
  "name": "@ampara/identidade",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "nest build -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:e2e": "jest test/e2e",
    "migration:run": "typeorm migration:run -d dist/data-source.js"
  },
  "jest": {
    "testEnvironment": "node",
    "transform": {
      "^.+\\.[tj]s$": ["ts-jest", { "tsconfig": "tsconfig.spec.json" }]
    },
    "transformIgnorePatterns": ["/node_modules/(?!@nestjs/jwt/)"],
    "roots": ["<rootDir>/src", "<rootDir>/test"],
    "testRegex": "\\.(spec|e2e-spec)\\.ts$",
    "setupFiles": ["<rootDir>/test/support/ambiente.ts"],
    "testTimeout": 20000
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^12.0.4",
    "@nestjs/platform-express": "^11.0.1",
    "amqplib": "^2.3.1",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "nestjs-pino": "^4.4.0",
    "pg": "^8.13.1",
    "pino-http": "^10.3.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.21"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/amqplib": "^0.10.8",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.1",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "jest": "^29.7.0",
    "pg-mem": "^3.0.14",
    "supertest": "^7.3.2",
    "ts-jest": "^29.4.15",
    "typescript": "^5.7.2"
  }
}
